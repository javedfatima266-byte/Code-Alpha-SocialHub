# PostgreSQL Database Connection URL (e.g. Neon, Supabase, Cloud SQL)
# Leave empty during local development to use the automatic in-memory PostgreSQL emulator
# Configure in Vercel Environment Variables for production deployment
DATABASE_URL=

# Secret key used to sign JWT tokens and auth cookies
# Leave empty during local development to use a secure dynamic runtime secret
# Configure a strong random secret in Vercel Environment Variables for production deployment
SESSION_SECRET=

# Local Server Port (optional, defaults to 3000)
PORT=3000

# Vercel Blob Storage Token for production image uploads
# Leave empty during development — local disk / data URI fallback is automatically used
# Configure in Vercel Environment Variables when Blob Store is added
BLOB_READ_WRITE_TOKEN=

